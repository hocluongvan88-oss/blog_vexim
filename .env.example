# ============================================================
# BIẾN MÔI TRƯỜNG — VEXIM GLOBAL
# Sao chép file này thành .env.local (khi chạy máy) hoặc dán vào
# Vercel → Settings → Environment Variables (khi chạy thật).
# ============================================================

# ---- Supabase (bắt buộc) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI trả lời khách (cần MỘT trong hai key dưới đây) ----
#
# Cách 1 — Groq: nhanh, miễn phí ~1.000 request/ngày.
#   Lấy key tại https://console.groq.com/keys
#   (Lưu ý: Groq đã ngừng phục vụ các model Llama từ 16/08/2026;
#    hệ thống dùng openai/gpt-oss-120b và tự chuyển model khi cần.)
GROQ_API_KEY=
#
# Cách 2 — Google Gemini: miễn phí, và CŨNG dùng cho embedding bên dưới.
#   Lấy key tại https://aistudio.google.com/apikey
#   Chỉ cần key này là chatbot đã trả lời được (không bắt buộc phải có Groq).
GEMINI_API_KEY=
#
# Có CẢ HAI thì Groq trả lời chính, Gemini tự động dự phòng khi Groq lỗi
# (hết hạn mức, model bị khai tử, key sai) — chatbot gần như không bao giờ im lặng.
#
# Ghi đè khi cần (thường không phải đổi):
# CHAT_PROVIDER=groq                 # groq | gemini — ưu tiên bên nào trước
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.8-flash
#
# ---- Embedding: để AI hiểu tài liệu theo NGỮ NGHĨA (tuỳ chọn nhưng nên bật) ----
# Groq KHÔNG có API embedding, nên cần GEMINI_API_KEY ở trên (khuyến nghị) hoặc OpenAI.
#
# Hoặc OpenAI (~0,02 USD / 1 triệu token):
# OPENAI_API_KEY=
#
# Ghi đè khi cần (thường không phải đổi):
# EMBEDDING_PROVIDER=gemini          # gemini | openai
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=1536          # PHẢI khớp cột vector trong scripts/038_add_knowledge_embeddings.sql
# EMBEDDING_MIN_SIMILARITY=0.5       # ngưỡng tương đồng tối thiểu (Gemini ~0.5, OpenAI ~0.3)

# ---- Email thông báo cho admin (Zoho SMTP) ----
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@veximglobal.com
MAIL_FROM_NAME=VEXIM GLOBAL

# ---- Web Push (thông báo nổi trên điện thoại/máy tính) ----
# Tạo bằng: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@veximglobal.com
INTERNAL_API_KEY=

# Thời gian tối đa (ms) chờ MỘT nhà cung cấp AI trả lời trước khi chuyển sang
# nhà cung cấp dự phòng. Mặc định 15000 (tối thiểu 1000).
# AI_REQUEST_TIMEOUT_MS=15000

# ---- Zalo OA (nhận tin nhắn khách qua Zalo) ----
ZALO_ACCESS_TOKEN=
ZALO_OA_ID=

# ---- Facebook Messenger (nếu dùng) ----
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=

# ---- Cron / bảo mật ----
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=https://www.veximglobal.com
